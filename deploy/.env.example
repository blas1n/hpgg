# Copy to deploy/.env on the host (gitignored). Only HP_API_TOKEN is required.
# Heroes Profile v1 key (same key as the collector's Actions secret). Never commit it.
HP_API_TOKEN=
# Browser origins allowed by CORS (JSON list). Default: ["https://hpgg.win"]
# CORS_ORIGINS=["https://hpgg.win"]
# LOG_LEVEL=INFO
# Player search guard rails (defaults shown)
# PLAYER_TTL_SECONDS=21600
# NOT_FOUND_TTL_SECONDS=3600
# QUOTA_FLOOR=200
# DAILY_LIVE_BUDGET=1300
# IP_REQUESTS_PER_MINUTE=20
# Battle.net sign-in (#28). No client id = sign-in is off (503). The secret comes from the vault:
# ~/Works/_infra/scripts/secrets-sync.sh → ~/.hpgg/bnet_client_secret. The client id is public.
# BNET_CLIENT_ID=
# BNET_CLIENT_SECRET=
